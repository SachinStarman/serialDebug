{
  "name": "serial-debug-assistant-pro",
  "version": "1.1.0-beta.4",
  "description": "Professional Serial Debug Assistant — COM, TCP, UDP with waveform, scripting, and more",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Serial Debug Pro",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.serialdebug.pro",
    "productName": "Serial Debug Assistant Pro Beta",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chart.js": "^4.4.0",
    "chartjs-adapter-luxon": "^1.3.1",
    "chartjs-plugin-streaming": "^2.0.0",
    "iconv-lite": "^0.6.3",
    "luxon": "^3.4.0",
    "serialport": "^12.0.0"
  }
}
